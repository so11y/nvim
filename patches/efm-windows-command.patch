diff --git a/langserver/format_command_errors_test.go b/langserver/format_command_errors_test.go
new file mode 100644
--- /dev/null
+++ b/langserver/format_command_errors_test.go
@@ -0,0 +1,31 @@
+package langserver
+
+import (
+	"log"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestFormattingCommandFailure(t *testing.T) {
+	base, _ := os.Getwd()
+	uri := toURI(filepath.Join(base, "format-failure.js"))
+	command := "echo formatter-failed 1>&2; exit 1"
+	if runtime.GOOS == "windows" {
+		command = "echo formatter-failed 1>&2 & exit /b 1"
+	}
+	handler := &langHandler{
+		logger: log.New(log.Writer(), "", 0), rootPath: base,
+		configs: map[string][]Language{"javascript": {{FormatCommand: command, FormatStdin: true}}},
+		files:   map[DocumentURI]*File{uri: {LanguageID: "javascript", Text: "const value = 1;"}},
+	}
+	edits, err := handler.rangeFormatting(uri, Range{Position{-1, -1}, Position{-1, -1}}, FormattingOptions{})
+	if err == nil || !strings.Contains(err.Error(), "formatter-failed") {
+		t.Fatalf("formatter failure should reach the client with stderr; got %v", err)
+	}
+	if len(edits) != 0 {
+		t.Fatalf("failed formatting must not edit the document: %v", edits)
+	}
+}
