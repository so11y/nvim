--- /dev/null
+++ b/langserver/format_command_windows.go
@@ -0,0 +1,12 @@
+package langserver
+
+import (
+	"os/exec"
+	"syscall"
+)
+
+func formattingCommand(command string) *exec.Cmd {
+	cmd := exec.Command("cmd.exe")
+	cmd.SysProcAttr = &syscall.SysProcAttr{CmdLine: `cmd.exe /d /s /c "` + command + `"`}
+	return cmd
+}
